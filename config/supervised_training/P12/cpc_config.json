{
  "data_dir": "./dataset/P12",
  "output_dir": "./output/P12",
  "input_dim": 6,
  "window_size": 120,
  "overlap": 0.9,
  "batch_size": 32,
  "num_epochs": 25,
  "d_model": 128,
  "nhead": 4,
  "num_layers": 3,
  "dropout": 0.2,
  "device": "cuda:0",
  "learning_rate": 0.0005,
  "weight_decay": 1e-05,
  "scheduler": "plateau",
  "lr_factor": 0.5,
  "patience": 5,
  "early_stopping_patience": 8,
  "sampling_rate": 50,
  "labeled_data_dir": "./dataset/P12",
  "gradient_clipping": true,
  "clip_value": 1.0,
  "use_class_weights": true,
  "balance_classes": true,
  "balance_threshold": 1.5,
  "jitter_scale": 0.1,
  "time_warp_scale": 0.2,
  "rotation_angle": 10,
  "magnitude_scale": 0.1,
  "random_seed": 42,
  "num_workers": 4,
  "pin_memory": true,
  "progressive_unfreezing": true,
  "unfreeze_after": 5,
  "use_layerwise_lr": true,
  "freeze_strategy": "none",
  "pretrained_path": "./pretrained_cpc_models/P12/best_cpc_model.pth",
  "pretraining_task": "cpc"
}
